# Copy this file to secrets.toml (same folder) and fill in your own values.
# secrets.toml is in .gitignore, so it is NEVER uploaded to GitHub.
FACEIT_API_KEY = "paste-your-key-here"
FACEIT_NICKNAME = "your-faceit-nickname"
# Leetify (optional, separate from FACEIT). Default is "false" = Leetify is off.
# Set to "true" to show the Leetify page.
LEETIFY_ENABLED = "false"
LEETIFY_API_KEY = "paste-your-leetify-key-here"
STEAM_ID = "your-17-digit-steam64-id"  # optional; if empty, the Steam ID from FACEIT is used
